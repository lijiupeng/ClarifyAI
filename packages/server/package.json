{
  "name": "clarifyai",
  "version": "0.1.2",
  "description": "让 AI 在写代码前把需求问清楚 —— MCP 驱动的需求澄清与逐层拆解工具",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "clarifyai": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijiupeng/ClarifyAI.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/lijiupeng/ClarifyAI#readme",
  "bugs": {
    "url": "https://github.com/lijiupeng/ClarifyAI/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "ai-agents",
    "requirements",
    "requirements-engineering",
    "spec-driven-development",
    "claude-code",
    "cursor",
    "mindmap"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts --mode=both",
    "start": "tsx src/index.ts --mode=both",
    "start:http": "tsx src/index.ts --mode=http",
    "mcp": "tsx src/index.ts --mode=mcp",
    "build": "tsup && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "mcp:inspect": "npx -y @modelcontextprotocol/inspector tsx src/index.ts --mode=mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^4.21.2",
    "nanoid": "^5.0.9",
    "open": "^10.1.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@clarifyai/shared": "*",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsup": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
